# Copy this file to .env and fill in your keys. NEVER commit .env.
# mock = offline test double (no keys needed) | live = real free-tier models
LLM_MODE=mock

# Google AI Studio (free tier, no billing): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: more keys, comma-separated, tried in order on each model BEFORE moving to the next model.
# Limits are per Google Cloud PROJECT, not per key: only keys from different projects/accounts add capacity
# (e.g. each teammate's own free key). Never share keys publicly.
GEMINI_API_KEYS=
# native = Google generateContent API (recommended) | openai = OpenAI-compatible endpoint
GEMINI_API_STYLE=native
# Use the latest Flash model your AI Studio console lists as FREE (check the rate-limit page there)
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: more Groq keys (comma-separated), rotated the same way; per-minute limits switch key instantly
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
# Planner, conflict explanations and follow-up wording run here (light, frequent calls; keeps Gemini quota for reading)
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Free Gemini quota can be ~20 requests/day PER MODEL. When GEMINI_MODEL runs out, these are tried in order
# (comma-separated IDs printed by scripts/check_providers.py, e.g. a -flash-lite model). Exhausted models are
# remembered in logs/quota_state.json and skipped instantly until their reset.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemma-4-26b-a4b-it
# Per-role models (free quota differs per model: Flash ~20/day, Flash-Lite ~500/day). Reading = quality-critical.
GEMINI_EXTRACT_MODEL=gemini-3.5-flash
GEMINI_DRAFT_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
GROQ_ALT_MODEL=qwen/qwen3.8-27b
# Last resort when all Gemini models are out: extraction -> Groq gpt-oss-120b, drafting -> GROQ_FAST_MODEL
# (never the verifier's model). Scanned-page reading has no Groq fallback (Tesseract OCR covers it).
ALLOW_GROQ_FALLBACK=1

# Real-data scripts only: free key from https://open.fda.gov/apis/authentication
OPENFDA_API_KEY=

# Thinking depth for Gemini 3.x Flash and gpt-oss: low = fast + fewer tokens ("" = provider default)
GEMINI_REASONING_EFFORT=low
GROQ_REASONING_EFFORT=low
LLM_TIMEOUT=90

# Stay under the free limits (requests per minute)
GEMINI_RPM=8
GROQ_RPM=25

# Scanned pages: tesseract = free local OCR (default) | gemini = Gemini vision
OCR_ENGINE=tesseract
# Windows only, if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# In live mode, pages with mean OCR confidence below this are re-read by Gemini vision
OCR_MIN_CONFIDENCE=70

# llm = agentic planner (an LLM decides each step) | rules = deterministic fallback
PLANNER=llm
# 1 = cache identical LLM calls on disk (saves free quota during development)
LLM_CACHE=1
LOG_LEVEL=INFO
